# Telegram Bot Token (Lấy từ @BotFather trên Telegram)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Groq API Key (Lấy từ console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Model Groq (Mặc định dùng Llama 3.3 70B hoặc 3.1 8B)
GROQ_MODEL=llama-3.3-70b-versatile

# Đường dẫn file SQLite database
DB_PATH=expense_tracker.db

# Giờ nhắc nhở báo cáo hàng ngày (24h format, ví dụ: 22:00)
REMINDER_HOUR=22
REMINDER_MINUTE=0
